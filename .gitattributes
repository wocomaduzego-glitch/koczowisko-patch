# Skrypty Windows muszą mieć CRLF — inaczej cmd rozbija je na pojedyncze litery.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
